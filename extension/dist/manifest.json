{
  "manifest_version": 3,
  "name": "Grabify Integration",
  "description": "Send links and supported non-DRM videos to Grabify Download Manager.",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["contextMenus", "nativeMessaging", "storage", "notifications", "downloads"],
  "optional_permissions": ["webRequest"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-script.js"], "run_at": "document_idle"}],
  "background": { "service_worker": "service-worker.js" },
  "options_page": "options.html",
  "action": { "default_title": "Grabify Integration" },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
