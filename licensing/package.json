{
  "name": "rivlet-licensing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Rivlet licensing backend — Cloudflare Worker + D1 + Durable Objects",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply rivlet-licensing --local",
    "migrate:remote": "wrangler d1 migrations apply rivlet-licensing --remote",
    "keygen": "node scripts/keygen.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.9.0",
    "@cloudflare/workers-types": "^5.20260708.1",
    "typescript": "^5.6.0",
    "vitest": "~3.2.0",
    "wrangler": "^4.20.0"
  }
}
